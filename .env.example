# Copy this file to .env. Fill in your own keys; never commit .env.
# LLM: BoxAPI + Luna by default. Alternatives: codex | claude.
LYARA_PROVIDER=api
LYARA_LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LYARA_MODEL=openai/gpt-6-luna
LYARA_LLM_API_KEY=

# Liara infrastructure credentials. Not needed for --demo or local fixture labs.
LIARA_API_TOKEN=
LIARA_TEAM_ID=

# Paths relative to this env file.
LYARA_WORKSPACE=.
LYARA_DATA_DIR=.lyara

# Required for a remotely hosted web interface.
LYARA_ACCESS_TOKEN=
# Hostname only, without https:// or a path, for example your-app.liara.run.
LYARA_PUBLIC_HOST=
# Docker defaults: LYARA_WORKSPACE=/workspace, LYARA_DATA_DIR=/data.
# Mount the Liara disk named data at /data; do not upload this project's .env.

# Operator-provided hosting choices, including current price/terms. Empty = no purchase choice.
# Example: [{"id":"PLAN_ID","title":"Basic site","cost":"Current monthly price and terms"}]
LYARA_HOSTING_OPTIONS=[]
