# Copy to .env. Keep credentials out of source control and chat.
LIARA_API_TOKEN=
LIARA_TEAM_ID=
LYARA_WORKSPACE=.
LYARA_DATA_DIR=.lyara
# codex | claude | api. MCP tools also work without a model provider.
LYARA_PROVIDER=api
LYARA_MODEL=openai/gpt-6-luna
LYARA_LLM_API_KEY=
LYARA_LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
# Required for a remotely hosted web interface; browser asks for this token.
LYARA_ACCESS_TOKEN=
